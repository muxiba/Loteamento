{
 "framework":"vite",
 "buildCommand":"npm run build",
 "outputDirectory":"dist",
 "functions":{"api/index.js":{"maxDuration":60}},
 "rewrites":[{"source":"/api/:path*","destination":"/api/index?__path=:path*"},{"source":"/cliente","destination":"/index.html"},{"source":"/admin","destination":"/index.html"},{"source":"/proposta","destination":"/index.html"}],
 "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]},{"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]}]
}
